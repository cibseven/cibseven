<?xml version="1.0" encoding="UTF-8"?>
<!-- Case 12 - all four ways result variables are derived -->
<definitions id="defs_adHocAgent12" xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" targetNamespace="http://cibseven.org/adhoc-agent">
  <process id="adHocAgent12" name="Case 12 - all four ways result variables are derived" isExecutable="true" camunda:historyTimeToLive="P30D">
    <startEvent id="start" />
    <sequenceFlow id="f1" sourceRef="start" targetRef="adHoc" />
    <adHocSubProcess id="adHoc" name="Agentic scope">
      <documentation>One child per derivation path: output parameters, camunda:resultVariable, the explicit adHocResultVariables property for a write the model does not describe, and a user task's form field ids. Nothing here needs the modeller to list variables except calcViaProperty, which has nothing to derive from.</documentation>
      <extensionElements>
        <camunda:properties>
            <camunda:property name="explicitCompletionOnly" value="true" />
            <camunda:property name="adHocDriverActivity" value="agent" />
            <camunda:property name="activeActivityIds" value="agent" />
        </camunda:properties>
      </extensionElements>
      <serviceTask id="agent" name="AI Agent" camunda:asyncBefore="true">
        <extensionElements>
          <camunda:connector>
            <camunda:connectorId>cibseven-ai-agent</camunda:connectorId>
            <camunda:inputOutput>
              <camunda:inputParameter name="agentName">Ad-hoc Agent</camunda:inputParameter>
              <camunda:inputParameter name="instruction">Du steuerst einen Ad-hoc-Bereich. Fuehre alle vier Aktivitaeten aus und beende den Bereich danach.</camunda:inputParameter>
              <camunda:inputParameter name="instructionMode">append</camunda:inputParameter>
              <camunda:inputParameter name="message">Fuehre alle Aktivitaeten aus und berichte die Ergebnisse.</camunda:inputParameter>
              <camunda:inputParameter name="toolClasses">org.cibseven.connect.ai.agent.impl.AdHocSubProcessTool</camunda:inputParameter>
              <camunda:inputParameter name="useChatMemory">${true}</camunda:inputParameter>
              <camunda:outputParameter name="agentOutput">${output}</camunda:outputParameter>
              <camunda:outputParameter name="memoryId">${memoryId}</camunda:outputParameter>
            </camunda:inputOutput>
          </camunda:connector>
        </extensionElements>
      </serviceTask>
      <serviceTask id="calculateOrder" name="Calculate order (output mapping)" camunda:expression="${true}">
        <extensionElements>
            <camunda:inputOutput>
              <camunda:outputParameter name="amount">${1200}</camunda:outputParameter>
              <camunda:outputParameter name="currency">${'EUR'}</camunda:outputParameter>
              <camunda:outputParameter name="valid">${true}</camunda:outputParameter>
            </camunda:inputOutput>
        </extensionElements>
      </serviceTask>
      <serviceTask id="calcViaResultVariable" name="Calculate (result variable)" camunda:expression="${1200}" camunda:resultVariable="amount2" />
      <serviceTask id="calcViaProperty" name="Calculate (explicit property)" camunda:expression="${execution.setVariable('note','written without a declaration')}">
        <extensionElements>
            <camunda:properties>
              <camunda:property name="adHocResultVariables" value="note" />
            </camunda:properties>
        </extensionElements>
      </serviceTask>
      <userTask id="approveWithForm" name="Approve (form fields)">
        <extensionElements>
          <camunda:formData>
              <camunda:formField id="approvedByForm" label="Approved?" type="boolean" />
              <camunda:formField id="comment" label="Comment" type="string" />
          </camunda:formData>
        </extensionElements>
      </userTask>
    </adHocSubProcess>
    <sequenceFlow id="f2" sourceRef="adHoc" targetRef="end" />
    <endEvent id="end" />
  </process>
  <bpmndi:BPMNDiagram id="diagram">
    <bpmndi:BPMNPlane id="plane" bpmnElement="adHocAgent12">
      <bpmndi:BPMNShape id="di_start" bpmnElement="start">
        <dc:Bounds x="152" y="172" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_adHoc" bpmnElement="adHoc" isExpanded="true">
        <dc:Bounds x="240" y="80" width="980" height="220" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_agent" bpmnElement="agent">
        <dc:Bounds x="280" y="150" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_calculateOrder" bpmnElement="calculateOrder">
        <dc:Bounds x="460" y="150" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_calcViaResultVariable" bpmnElement="calcViaResultVariable">
        <dc:Bounds x="640" y="150" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_calcViaProperty" bpmnElement="calcViaProperty">
        <dc:Bounds x="820" y="150" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_approveWithForm" bpmnElement="approveWithForm">
        <dc:Bounds x="1000" y="150" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_end" bpmnElement="end">
        <dc:Bounds x="1280" y="172" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="di_f1" bpmnElement="f1">
        <di:waypoint x="188" y="190" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" />
        <di:waypoint x="240" y="190" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="di_f2" bpmnElement="f2">
        <di:waypoint x="1220" y="190" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" />
        <di:waypoint x="1280" y="190" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
