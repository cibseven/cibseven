<?xml version="1.0" encoding="UTF-8"?>
<!-- Case 08 - the agent ends the scope without starting anything -->
<definitions id="defs_adHocAgent08" xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" targetNamespace="http://cibseven.org/adhoc-agent">
  <process id="adHocAgent08" name="Case 08 - the agent ends the scope without starting anything" isExecutable="true" camunda:historyTimeToLive="P30D">
    <startEvent id="start" />
    <sequenceFlow id="f1" sourceRef="start" targetRef="adHoc" />
    <adHocSubProcess id="adHoc" name="Agentic scope">
      <documentation>The scope offers one thing to do and the instruction tells the agent not to do it. The parking stops the scope ending by itself while nothing is active, so completeScope is what ends it - and the process then continues past the scope.</documentation>
      <extensionElements>
        <camunda:properties>
            <camunda:property name="cibseven.agentic.enabled" value="true" />
            <camunda:property name="cibseven.agentic.agentName" value="Ad-hoc Agent" />
            <camunda:property name="cibseven.agentic.instruction" value="Du steuerst einen Ad-hoc-Bereich. Es ist nichts zu tun. Beende den Bereich sofort." />
            <camunda:property name="cibseven.agentic.instructionMode" value="append" />
            <camunda:property name="cibseven.agentic.message" value="Es ist nichts zu tun. Beende den Ad-hoc-Bereich." />
            <camunda:property name="cibseven.agentic.resultVariable" value="agentOutput" />
        </camunda:properties>
      </extensionElements>
      <serviceTask id="notNeeded" name="Not needed" camunda:expression="${1}"
          camunda:resultVariable="ignored">
        <documentation>Offered and meant to stay unstarted. An agentic scope needs something it could start, or the deployment is refused - and a scope that offers nothing could not be agentic in the first place.</documentation>
      </serviceTask>
    </adHocSubProcess>
    <sequenceFlow id="f2" sourceRef="adHoc" targetRef="end" />
    <endEvent id="end" />
  </process>
  <bpmndi:BPMNDiagram id="diagram">
    <bpmndi:BPMNPlane id="plane" bpmnElement="adHocAgent08">
      <bpmndi:BPMNShape id="di_start" bpmnElement="start">
        <dc:Bounds x="152" y="172" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_adHoc" bpmnElement="adHoc" isExpanded="true">
        <dc:Bounds x="240" y="80" width="260" height="220" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_notNeeded" bpmnElement="notNeeded">
        <dc:Bounds x="300" y="150" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_end" bpmnElement="end">
        <dc:Bounds x="560" y="172" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="di_f1" bpmnElement="f1">
        <di:waypoint x="188" y="190" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" />
        <di:waypoint x="240" y="190" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="di_f2" bpmnElement="f2">
        <di:waypoint x="500" y="190" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" />
        <di:waypoint x="560" y="190" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
