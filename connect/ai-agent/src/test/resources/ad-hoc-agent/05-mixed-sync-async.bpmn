<?xml version="1.0" encoding="UTF-8"?>
<!-- Case 05 - sync, then async with a wait, then sync, then completion -->
<definitions id="defs_adHocAgent05" xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" targetNamespace="http://cibseven.org/adhoc-agent">
  <process id="adHocAgent05" name="Case 05 - sync, then async with a wait, then sync, then completion" isExecutable="true" camunda:historyTimeToLive="P30D">
    <startEvent id="start" />
    <sequenceFlow id="f1" sourceRef="start" targetRef="adHoc" />
    <adHocSubProcess id="adHoc" name="Agentic scope">
      <documentation>The realistic end-to-end case: a synchronous result inside one turn, a wait that spans transactions, a value read from history afterwards, and an explicit end.</documentation>
      <extensionElements>
        <camunda:properties>
            <camunda:property name="explicitCompletionOnly" value="true" />
            <camunda:property name="adHocDriverActivity" value="agent" />
            <camunda:property name="activeActivityIds" value="agent" />
        </camunda:properties>
      </extensionElements>
      <serviceTask id="agent" name="AI Agent" camunda:asyncBefore="true"
          camunda:modelerTemplate="org.cibseven.connect.ai.agent"
          camunda:modelerTemplateVersion="1">
        <extensionElements>
          <camunda:connector>
            <camunda:connectorId>cibseven-ai-agent</camunda:connectorId>
            <camunda:inputOutput>
              <camunda:inputParameter name="agentName">Ad-hoc Agent</camunda:inputParameter>
              <camunda:inputParameter name="instruction">Du steuerst einen Ad-hoc-Bereich. Ermittle den Preis, lasse die Bestellung genehmigen, versende danach die Bestaetigung und beende den Bereich.</camunda:inputParameter>
              <camunda:inputParameter name="instructionMode">append</camunda:inputParameter>
              <camunda:inputParameter name="message">Bereite die Bestellung vor, lasse sie genehmigen und bestaetige sie.</camunda:inputParameter>
              <camunda:inputParameter name="toolClasses">org.cibseven.connect.ai.agent.impl.AdHocSubProcessTool</camunda:inputParameter>
              <camunda:inputParameter name="useChatMemory">${true}</camunda:inputParameter>
              <camunda:outputParameter name="agentOutput">${output}</camunda:outputParameter>
              <camunda:outputParameter name="memoryId">${memoryId}</camunda:outputParameter>
            </camunda:inputOutput>
          </camunda:connector>
        </extensionElements>
      </serviceTask>
      <serviceTask id="calculatePrice" name="Calculate price" camunda:expression="${1200}" camunda:resultVariable="price" />
      <userTask id="approveOrder" name="Approve order">
        <extensionElements>
          <camunda:formData>
              <camunda:formField id="approved" label="Approved?" type="boolean" />
          </camunda:formData>
        </extensionElements>
      </userTask>
      <serviceTask id="sendConfirmation" name="Send confirmation" camunda:expression="${true}" camunda:resultVariable="confirmationSent" />
    </adHocSubProcess>
    <sequenceFlow id="f2" sourceRef="adHoc" targetRef="end" />
    <endEvent id="end" />
  </process>
  <bpmndi:BPMNDiagram id="diagram">
    <bpmndi:BPMNPlane id="plane" bpmnElement="adHocAgent05">
      <bpmndi:BPMNShape id="di_start" bpmnElement="start">
        <dc:Bounds x="152" y="172" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_adHoc" bpmnElement="adHoc" isExpanded="true">
        <dc:Bounds x="240" y="80" width="800" height="220" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_agent" bpmnElement="agent">
        <dc:Bounds x="280" y="150" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_calculatePrice" bpmnElement="calculatePrice">
        <dc:Bounds x="460" y="150" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_approveOrder" bpmnElement="approveOrder">
        <dc:Bounds x="640" y="150" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_sendConfirmation" bpmnElement="sendConfirmation">
        <dc:Bounds x="820" y="150" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_end" bpmnElement="end">
        <dc:Bounds x="1100" y="172" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="di_f1" bpmnElement="f1">
        <di:waypoint x="188" y="190" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" />
        <di:waypoint x="240" y="190" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="di_f2" bpmnElement="f2">
        <di:waypoint x="1040" y="190" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" />
        <di:waypoint x="1100" y="190" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
