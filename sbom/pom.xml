<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.cibseven.bpm</groupId>
    <artifactId>cibseven-root</artifactId>
    <version>2.3.0-SNAPSHOT</version>
    <relativePath>../</relativePath>
  </parent>

  <artifactId>cibseven-sbom</artifactId>
  <packaging>pom</packaging>
  <name>CIB seven - SBOM</name>
  <description>Holds the aggregate CycloneDX Software Bill of Materials generated for the CIB seven build</description>

  <properties>
    <!-- This module is excluded since it attaches the whole-project aggregate itself -->
    <cyclonedx.skip>true</cyclonedx.skip>
  </properties>

  <profiles>
    <profile>
      <!-- Activated via -Dsbom.create=true (see Jenkinsfile.cib), set alongside the CLI call that
           generates the aggregate SBOM before "clean deploy" runs.
           The aggregate SBOM is generated into sbom-generated/, a directory outside every module's
           own target/ - this module's own "clean" phase runs as part of the same combined build
           and would otherwise wipe files placed under its own target/ before package/deploy get
           to attach and push them. -->
      <id>attach-sbom</id>
      <activation>
        <property>
          <name>sbom.create</name>
          <value>true</value>
        </property>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>build-helper-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>attach-sbom-files</id>
                <phase>package</phase>
                <goals>
                  <goal>attach-artifact</goal>
                </goals>
                <configuration>
                  <artifacts>
                    <artifact>
                      <file>${project.basedir}/../sbom-generated/cibseven-sbom.json</file>
                      <type>json</type>
                      <classifier>cyclonedx</classifier>
                    </artifact>
                    <artifact>
                      <file>${project.basedir}/../sbom-generated/cibseven-sbom.xml</file>
                      <type>xml</type>
                      <classifier>cyclonedx</classifier>
                    </artifact>
                  </artifacts>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>

  <licenses>
    <license>
      <name>The Apache Software License, Version 2.0</name>
      <url>http://www.apache.org/licenses/LICENSE-2.0.txt</url>
    </license>
  </licenses>

  <organization>
    <name>CIB seven</name>
    <url>https://cibseven.org</url>
  </organization>

  <url>https://cibseven.org</url>

  <developers>
    <developer>
      <id>CIB seven</id>
      <name>CIB seven Community</name>
      <organization>CIB seven</organization>
      <organizationUrl>https://cibseven.org</organizationUrl>
    </developer>
  </developers>

  <scm>
    <url>https://github.com/cibseven/cibseven</url>
    <connection>scm:git:git@github.com:cibseven/cibseven.git</connection>
    <developerConnection>scm:git:git@github.com:cibseven/cibseven.git</developerConnection>
    <tag>HEAD</tag>
  </scm>

  <issueManagement>
    <system>GitHub Issues</system>
    <url>https://github.com/cibseven/cibseven/issues</url>
  </issueManagement>

</project>
