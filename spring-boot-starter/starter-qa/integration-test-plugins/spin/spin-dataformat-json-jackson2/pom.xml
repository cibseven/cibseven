<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.cibseven.bpm.springboot.project</groupId>
    <artifactId>qa-plugins-spin</artifactId>
    <version>3.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>qa-plugins-spin-dataformat-json-jackson2</artifactId>
  <name>CIB seven - Spring Boot Starter - QA - Plugins - Spin Json Jackson 2 (deprecated variant)</name>

  <properties>
    <!-- uses the deprecated Jackson 2 variant of Spin on purpose: ban the Jackson 3 artifacts instead
         (enforce-single-spin-json-variant, see cibseven-parent) -->
    <spin.json.banned.json-jackson>org.cibseven.spin:cibseven-spin-dataformat-json-jackson</spin.json.banned.json-jackson>
    <spin.json.banned.all>org.cibseven.spin:cibseven-spin-dataformat-all</spin.json.banned.all>
  </properties>

  <dependencies>

    <dependency>
      <groupId>org.cibseven.bpm.springboot.project</groupId>
      <artifactId>qa-plugins-spin-dataformat-json-jackson</artifactId>
      <version>${project.version}</version>
      <exclusions>
        <exclusion>
          <groupId>org.cibseven.spin</groupId>
          <artifactId>cibseven-spin-dataformat-json-jackson</artifactId>
        </exclusion>
      </exclusions>
    </dependency>

    <dependency>
      <groupId>org.cibseven.spin</groupId>
      <artifactId>cibseven-spin-dataformat-json-jackson2</artifactId>
    </dependency>

    <!-- The Jackson 2 modules the starter registers with the Jackson 2 variant of Spin (jsr310, jdk8,
         parameter names) come with cibseven-spin-dataformat-json-jackson2. They are not declared here on
         purpose: an application gets them the same way (CIB7-2681). -->

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  
  <profiles>
    <profile>
      <id>integration-test-spring-boot-starter</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-maven-plugin</artifactId>
            <configuration>
              <skip>true</skip>
            </configuration>
            <executions>
              <execution>
                <id>pre-integration-test</id>
                <goals>
                  <goal>start</goal>
                </goals>
              </execution>
              <execution>
                <id>post-integration-test</id>
                <goals>
                  <goal>stop</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>

  <description>
    The Spring Boot starter with the deprecated Jackson 2 variant of Spin (cibseven-spin-dataformat-json-jackson2)
  </description>

  <licenses>
    <license>
      <name>The Apache Software License, Version 2.0</name>
      <url>http://www.apache.org/licenses/LICENSE-2.0.txt</url>
    </license>
  </licenses>

  <organization>
    <name>CIB seven</name>
    <url>https://cibseven.org</url>
  </organization>

  <url>https://cibseven.org</url>

  <developers>
    <developer>
      <id>CIB seven</id>
      <name>CIB seven Community</name>
      <organization>CIB seven</organization>
      <organizationUrl>https://cibseven.org</organizationUrl>
    </developer>
  </developers>

  <scm>
    <url>https://github.com/cibseven/cibseven</url>
    <connection>scm:git:git@github.com:cibseven/cibseven.git</connection>
    <developerConnection>scm:git:git@github.com:cibseven/cibseven.git</developerConnection>
    <tag>HEAD</tag>
  </scm>

  <issueManagement>
    <system>GitHub Issues</system>
    <url>https://github.com/cibseven/cibseven/issues</url>
  </issueManagement>

</project>
