<?xml version="1.0" encoding="UTF-8"?>
<assembly xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xmlns="urn:maven:assembly:1.1.2">
  
  <id>tomcat</id>
  
  <formats>
    <format>war</format>
  </formats>

  <includeBaseDirectory>false</includeBaseDirectory>
  
  <dependencySets>
    <dependencySet>
      <outputDirectory>WEB-INF/lib</outputDirectory>
      <useTransitiveDependencies>true</useTransitiveDependencies>     
      <useTransitiveFiltering>true</useTransitiveFiltering>
      <scope>provided</scope>
      <includes>
        <include>org.cibseven.bpm:cibseven-engine-rest-core:jar</include>
        <!-- RESTEasy, as in 2.2 and as the Tomcat web applications and WildFly (CIB7-2618) -->
        <include>org.jboss.resteasy:resteasy-core:jar:*</include>
        <!-- Jakarta APIs, listed explicitly as in 2.2: Tomcat provides none of them, and with
             transitive filtering they would otherwise depend on the order of the declarations
             in the pom (RESTEasy and Jersey share them) -->
        <include>jakarta.ws.rs:jakarta.ws.rs-api:jar</include>
        <include>jakarta.annotation:jakarta.annotation-api:jar</include>
        <include>jakarta.validation:jakarta.validation-api:jar</include>
        <include>jakarta.xml.bind:jakarta.xml.bind-api:jar</include>
        <include>jakarta.activation:jakarta.activation-api:jar</include>
      </includes>
      <excludes>
        <exclude>org.cibseven.bpm:cibseven-engine-rest-core:jar:tests</exclude>
        <exclude>org.cibseven.bpm:cibseven-engine-rest-core:jar:sources</exclude>
        <exclude>net.bytebuddy:byte-buddy:jar:*</exclude>
        <exclude>net.bytebuddy:byte-buddy-agent:jar:*</exclude>
        <exclude>uk.org.webcompere:system-stubs-core:jar:*</exclude>
        <exclude>uk.org.webcompere:system-stubs-jupiter:jar:*</exclude>
      </excludes>
    </dependencySet>

    <dependencySet>
      <outputDirectory>/</outputDirectory>
      <includes>
        <include>org.cibseven.bpm:cibseven-engine-rest:war:*</include>        
      </includes>
      <unpack>true</unpack>   
      <unpackOptions>
        <excludes>
          <exclude>**/web.xml</exclude>  
        </excludes>
      </unpackOptions>   
    </dependencySet>    
  </dependencySets>
  
  <fileSets>
    <fileSet>
      <directory>src/main/runtime/tomcat/webapp</directory>
      <outputDirectory>/</outputDirectory>      
    </fileSet>     
  </fileSets>
  
</assembly>