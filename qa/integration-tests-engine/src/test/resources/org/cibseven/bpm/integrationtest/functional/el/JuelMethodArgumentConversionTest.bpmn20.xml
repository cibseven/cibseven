<?xml version="1.0" encoding="UTF-8"?>
<definitions
  xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
  targetNamespace="Examples">

  <process id="juelMethodArgumentConversion" isExecutable="true" camunda:historyTimeToLive="5">
    <startEvent id="start" />
    <sequenceFlow id="flow1" sourceRef="start" targetRef="expressionTask" />
    <serviceTask id="expressionTask" camunda:expression="${limit.compareTo(missing)}" camunda:resultVariable="fromExpression" />
    <sequenceFlow id="flow2" sourceRef="expressionTask" targetRef="scriptTask" />
    <scriptTask id="scriptTask" scriptFormat="juel" camunda:resultVariable="fromScript">
      <script>${limit.compareTo(missing)}</script>
    </scriptTask>
    <sequenceFlow id="flow3" sourceRef="scriptTask" targetRef="decisionTask" />
    <businessRuleTask id="decisionTask" camunda:decisionRef="juelMethodArgumentConversion"
      camunda:mapDecisionResult="singleEntry" camunda:resultVariable="fromDecision" />
    <sequenceFlow id="flow4" sourceRef="decisionTask" targetRef="userTask" />
    <userTask id="userTask" />
    <sequenceFlow id="flow5" sourceRef="userTask" targetRef="end" />
    <endEvent id="end" />
  </process>

</definitions>
