{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    // TEMPORARY: the raw "dependencyDashboard": false option turned out to be unreliable (a
    // Dependency Dashboard issue still got created once). This preset is the documented, more
    // robust way to fully disable it. Remove this entry to re-enable the dashboard.
    ":disableDependencyDashboard"
  ],
  "branchName": "{{{baseBranch}}}-{{{branchTopic}}}",
  "addLabels": [
    "dependencies"
  ],
  "prConcurrentLimit": 10,
  "baseBranchPatterns": [
    "main"
  ],
  "ignorePaths": [
    "**/qa/**"
  ],
  "vulnerabilityAlerts": {
    "enabled": false
  },
  // TEMPORARY: lock file maintenance paused for the initial rollout, to keep this first rollout
  // scoped to release-parent only. To re-enable, set "enabled" back to true.
  "lockFileMaintenance": {
    "enabled": false,
    "addLabels": [
      "automerge",
      "ci:e2e",
      "ci:rest-api"
    ],
  },
  "packageRules": [
    // TEMPORARY (commented out): Camunda's original allowlist of 19 trusted library families.
    // Restore this block - and remove/narrow the blanket-disable-all rule right below - once the
    // release-parent-only rollout has proven stable and you're ready to widen scope again.
    // {
    //   "matchPackageNames": [
    //     "!/^org.springframework/",
    //     "!/^org.apache.tomcat/",
    //     "!/^commons-fileupload/",
    //     "!/^org.apache.commons:commons-lang3/",
    //     "!/^net.minidev:json-smart/",
    //     "!/^com.jayway.jsonpath:json-path/",
    //     "!/^org.apache.httpcomponents.client5/",
    //     "!/^com.fasterxml.uuid/",
    //     "!/^com.fasterxml.jackson/",
    //     "!/^org.camunda.feel/",
    //     "!/^io.quarkus/",
    //     "!/^ch.qos.logback/",
    //     "!/^org.graalvm/",
    //     "!/^com.google.code.gson/",
    //     "!/^org.postgresql/",
    //     "!/^com.h2database/",
    //     "!/^com.mysql/",
    //     "!/^org.jboss.resteasy/",
    //     "!/^org.apache.groovy/"
    //   ],
    //   "enabled": false
    // },
    {
      // TEMPORARY: disables every dependency except release-parent (see the override rule below),
      // for a minimal-effect first rollout. Remove this rule (and uncomment the block above) to
      // restore the original 19-library allowlist.
      "matchPackageNames": [
        "*"
      ],
      "enabled": false
    },
    {
      "matchUpdateTypes": [
        "patch"
      ],
      // TEMPORARY: "automerge" label removed while auto-merge is disabled repo-wide (see
      // renovate-auto-merge.yml). Add "automerge" back to this list once you re-enable it there.
      "addLabels": [
        "ci:all"
      ]
    },
    {
      "matchUpdateTypes": [
        "major",
        "minor"
      ],
      "addLabels": [
        "ci:all"
      ],
      "automerge": false,
      "dependencyDashboardApproval": true
    },
    {
      // release-parent's available update is classified as "minor" (1.4.0 -> 1.6.0), so without
      // the dependencyDashboardApproval override below it would inherit "true" from the rule
      // above - which would block it forever, since the Dependency Dashboard is disabled above
      // and can never grant that approval.
      "matchPackageNames": [
        "org.cibseven:release-parent"
      ],
      "matchDepTypes": [
        "parent"
      ],
      "enabled": true,
      "dependencyDashboardApproval": false
    }
  ]
}
