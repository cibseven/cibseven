<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.cibseven.bpm.springboot.project</groupId>
    <artifactId>cibseven-bpm-spring-boot-4-starter-root</artifactId>
    <version>3.0.0-SNAPSHOT</version>
  </parent>

  <groupId>org.cibseven.bpm.springboot</groupId>
  <artifactId>cibseven-bpm-spring-boot-starter-webapp-legacy-4</artifactId>
  <name>CIB seven - Spring Boot 4 Starter - Legacy Webapps (Tests Only)</name>

  <properties>
    <!-- only used by the tests that still drive the engine through the legacy webapps; never published -->
    <maven.deploy.skip>true</maven.deploy.skip>
  </properties>

  <dependencies>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>cibseven-bpm-spring-boot-starter-webapp-core-4</artifactId>
      <version>${project.version}</version>
    </dependency>

    <dependency>
      <groupId>org.cibseven.bpm.webapp</groupId>
      <artifactId>cibseven-webapp-jakarta</artifactId>
      <version>${version.legacy-webapps}</version>
      <type>jar</type>
      <classifier>classes</classifier>
      <exclusions>
        <!-- the 2.x POM pulls in 2.x engine-rest artifacts; the current ones come from this build -->
        <exclusion>
          <groupId>*</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>

    <dependency>
      <groupId>org.cibseven.bpm.webapp</groupId>
      <artifactId>cibseven-webapp-webjar</artifactId>
      <scope>test</scope>
    </dependency>

    <dependency>
      <artifactId>cibseven-bpm-spring-boot-starter-test-4</artifactId>
      <groupId>${project.groupId}</groupId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-core</artifactId>
      <scope>test</scope>
      <version>${version.mockito}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-resttestclient</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-jdbc</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-security</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-failsafe-plugin</artifactId>
          <configuration>
            <!-- See CAM-11901 -->
            <useManifestOnlyJar>false</useManifestOnlyJar>
            <excludes>
              <!-- TODO: adjust test to cibseven webclient (if possible) and remove the exclusions -->
              <exclude>**/ChangedAppPathIT.java</exclude>
              <exclude>**/ChangedAppPathContainerBasedAuthIT.java</exclude>
              <exclude>**/EmptyAppPathIT.java</exclude>
            </excludes>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <!-- the UI files of the legacy webapps; the webjar built in this repository no longer contains them -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>unpack-legacy-webapps-for-tests</id>
            <phase>generate-test-resources</phase>
            <goals>
              <goal>unpack</goal>
            </goals>
            <configuration>
              <artifactItems>
                <artifactItem>
                  <groupId>org.cibseven.bpm.webapp</groupId>
                  <artifactId>cibseven-webapp-webjar</artifactId>
                  <version>${version.legacy-webapps}</version>
                  <outputDirectory>${project.build.testOutputDirectory}</outputDirectory>
                  <includes>META-INF/resources/webjars/camunda/**,META-INF/resources/plugin/**</includes>
                </artifactItem>
              </artifactItems>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <description>
    Description of CIB seven - Spring Boot 4 Starter - Legacy Webapps
  </description>

  <licenses>
    <license>
      <name>The Apache Software License, Version 2.0</name>
      <url>http://www.apache.org/licenses/LICENSE-2.0.txt</url>
    </license>
  </licenses>

  <organization>
    <name>CIB seven</name>
    <url>https://cibseven.org</url>
  </organization>

  <url>https://cibseven.org</url>

  <developers>
    <developer>
      <id>CIB seven</id>
      <name>CIB seven Community</name>
      <organization>CIB seven</organization>
      <organizationUrl>https://cibseven.org</organizationUrl>
    </developer>
  </developers>

  <scm>
    <url>https://github.com/cibseven/cibseven</url>
    <connection>scm:git:git@github.com:cibseven/cibseven.git</connection>
    <developerConnection>scm:git:git@github.com:cibseven/cibseven.git</developerConnection>
    <tag>HEAD</tag>
  </scm>

  <issueManagement>
    <system>GitHub Issues</system>
    <url>https://github.com/cibseven/cibseven/issues</url>
  </issueManagement>

</project>
