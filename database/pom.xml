  <properties>

    <!-- database driver versions -->
    <version.h2>2.3.232</version.h2>
    <version.h2-v1>1.4.200</version.h2-v1><!-- used for instance migration qa -->
    <version.oracle>23.5.0.24.07</version.oracle>
    <version.mariadb>1.7.6</version.mariadb>
    <version.mariadb-v1>1.1.8</version.mariadb-v1>
    <version.mysql>8.3.0</version.mysql>
    <version.sqlserver>12.8.2.jre11</version.sqlserver>
    <version.db2-11.5>11.5.0.0</version.db2-11.5>
    <version.db2>${version.db2-11.5}</version.db2>
    <version.postgresql>42.7.13</version.postgresql>
    <version.liquibase>4.8.0</version.liquibase>

    <!-- needed for sql script and backward compatibility checks -->
    <camunda.version.old>7.23.0</camunda.version.old>
    <cibseven.version.old>2.2.0</cibseven.version.old>

    <!--
      Appended to the Testcontainers JDBC URL parameters, which are part of the URL of the
      testcontainers profile in settings/maven/nexus-settings.xml, too: ?TC_REUSABLE=true in the
      QA tests (see qa/pom.xml), otherwise an empty string.
    -->
    <database.tc.reuse />
    <!-- Testcontainers JDBC URL parameters. By default, only database.tc.reuse -->
    <database.tc.params>${database.tc.reuse}</database.tc.params>
    <!--
      JDBC driver of the Maven plugins below: they load the driver class directly, and a
      Testcontainers JDBC URL needs the Testcontainers driver. Set by the database profiles that
      use a Testcontainers URL, and reset by the profiles that point at an external database.
    -->
    <database.plugin.driver>${database.driver}</database.plugin.driver>

    <!--
      Raw variants of the connection settings, for consumers that read the Maven property
      directly (the sql-maven-plugin and liquibase-maven-plugin below) instead of through a
      filtered XML resource, which decodes the entities again. They default to the normal
      properties and are only overridden where a value has to be XML encoded - see aurora15.
    -->
    <database.url.raw>${database.url}</database.url.raw>
    <database.password.raw>${database.password}</database.password.raw>

    <!--
      Connection URL of the externally hosted Aurora PostgreSQL clusters, shared by the aurora*
      profiles below, which differ only in the host they are given from outside.

      connectTimeout and loginTimeout are in seconds, sslResponseTimeout in milliseconds.
      sslResponseTimeout is the one that matters while a cluster resumes from auto-pause: it
      limits the wait for the answer to the SSL upgrade request and defaults to 5s.
      gssEncMode=disable skips the GSSAPI upgrade request, which these clusters do not use and
      which otherwise burns another 5s (gssResponseTimeout) before the SSL request is sent.

      aurora.url is filtered into the XML test configurations (camunda.cfg.xml), which Maven does
      not parse again, so the separator between the URL parameters has to survive as the XML
      entity &amp;amp; - hence the double escaping of &amp;amp;amp;. aurora.url.raw is the same URL with a
      plain '&amp;' for the consumers that read the Maven property directly. Keep both in sync.
    -->
    <aurora.url>jdbc:postgresql://${database.host}:${database.port}/${database.name}?sslmode=require&amp;amp;gssEncMode=disable&amp;amp;connectTimeout=90&amp;amp;loginTimeout=90&amp;amp;sslResponseTimeout=90000</aurora.url>
    <aurora.url.raw>jdbc:postgresql://${database.host}:${database.port}/${database.name}?sslmode=require&amp;gssEncMode=disable&amp;connectTimeout=90&amp;loginTimeout=90&amp;sslResponseTimeout=90000</aurora.url.raw>
  </properties>

