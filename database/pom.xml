    <!--
      Databases that are hosted externally (AWS) instead of being started by Testcontainers.
      They are reached over a plain JDBC connection, so they are combined with the `database`
      profile, which drops the schema before and after the test run, and with the profile of
      the underlying database technology, which provides the driver and the dialect:

        mvn test -Pdatabase,postgresql,aurora15 -Ddatabase.host=... -Ddatabase.username=... -Ddatabase.password=...
        mvn test -Pdatabase,sqlserver,azuresql  -Ddatabase.host=... -Ddatabase.username=... -Ddatabase.password=...

      Declared after the profiles they refine, so that `database.url` wins over the
      `jdbc:tc:` URL defined there. Only the host is confidential; port, database name and
      the connection parameters are kept here next to the rest of the database settings.
      See also the "What about database technology X in environment Y?" section in TESTING.md.
    -->
    <!--
      One profile per Aurora cluster. They share the URL defined in aurora.url above and differ
      only in the host, which is supplied from outside together with the credentials.
    -->
    <profile>
      <!-- Amazon Aurora PostgreSQL 15 -->
      <id>aurora15</id>
      <properties>
        <database.url>${aurora.url}</database.url>
        <database.url.raw>${aurora.url.raw}</database.url.raw>
        <!-- not a Testcontainers URL: undo the Testcontainers driver of the postgresql profile -->
        <database.plugin.driver>${database.driver}</database.plugin.driver>
      </properties>
    </profile>

    <profile>
      <!-- Amazon Aurora PostgreSQL 16 -->
      <id>aurora16</id>
      <properties>
        <database.url>${aurora.url}</database.url>
        <database.url.raw>${aurora.url.raw}</database.url.raw>
        <!-- not a Testcontainers URL: undo the Testcontainers driver of the postgresql profile -->
        <database.plugin.driver>${database.driver}</database.plugin.driver>
      </properties>
    </profile>

    <profile>
      <!-- Amazon Aurora PostgreSQL 17 -->
      <id>aurora17</id>
      <properties>
        <database.url>${aurora.url}</database.url>
        <database.url.raw>${aurora.url.raw}</database.url.raw>
