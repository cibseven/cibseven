    <profile>
      <!-- Amazon Aurora PostgreSQL 18 -->
      <id>aurora18</id>
      <properties>
        <database.url>jdbc:postgresql://${database.host}:${database.port}/${database.name}?service=aurora</database.url>
        <!-- not a Testcontainers URL: undo the Testcontainers driver of the postgresql profile -->
