    <profile>
      <id>testcontainers</id>
      <dependencyManagement>
        <dependencies>
          <dependency>
            <groupId>com.fasterxml.jackson</groupId>
            <artifactId>jackson-bom</artifactId>
            <version>${version.jackson}</version>
            <scope>import</scope>
            <type>pom</type>
          </dependency>
        </dependencies>
