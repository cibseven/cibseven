    <profile>
      <id>mariadb</id>
      <properties>
  
        <!-- copied from nexus-settings.xml -->
        <database.port>3307</database.port>
        <database.name>process-engine</database.name>
        <database.username>camunda</database.username>
        <database.password>camunda</database.password>

        <database.type>mariadb</database.type>
        <database.driver>org.mariadb.jdbc.Driver</database.driver>
        <database.datasource.class>org.mariadb.jdbc.MySQLDataSource</database.datasource.class>
        <database.tc.url>cammariadb:11.4</database.tc.url>
        <!--
          The parameters are separated by ? instead of &: Testcontainers accepts both and the URL
          then needs no XML escaping. With &amp;amp; the Maven plugins above read the escaped value,
          i.e. "amp;password", and would start a second container instead of using the one of the tests.
          TC_TMPFS puts the data directory in memory: the MariaDB/MySQL tests are I/O bound, which
          makes them about 30 % faster. Note that this is the memory of the Docker host, i.e. of the
          Docker-in-Docker sidecar in CI.
        -->
        <database.tc.params>/${database.name}?user=${database.username}?password=${database.password}?TC_TMPFS=/var/lib/mysql:rw${database.tc.reuse}</database.tc.params>
        <database.url>jdbc:tc:${database.tc.url}://localhost:${database.port}${database.tc.params}</database.url>
        <database.plugin.driver>org.testcontainers.jdbc.ContainerDatabaseDriver</database.plugin.driver>
      </properties>

      <dependencies>
        <dependency>
          <groupId>org.mariadb.jdbc</groupId>
          <artifactId>mariadb-java-client</artifactId>
          <scope>test</scope>
        </dependency>
      </dependencies>
      <build>
        <pluginManagement>
          <plugins>
            <plugin>
              <groupId>org.codehaus.mojo</groupId>
              <artifactId>sql-maven-plugin</artifactId>
              <dependencies>
                <dependency>
                  <groupId>org.mariadb.jdbc</groupId>
                  <artifactId>mariadb-java-client</artifactId>
                  <version>${version.mariadb}</version>
                </dependency>
              </dependencies>
            </plugin>
          </plugins>
        </pluginManagement>
      </build>
    </profile>

