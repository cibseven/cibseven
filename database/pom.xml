    <!--
      Externally hosted databases, combined with the `database` profile and the profile of the
      database technology. Host and credentials are supplied from outside:

        mvn test -Pdatabase,postgresql,aurora15 -Ddatabase.host=... -Ddatabase.username=... -Ddatabase.password=...
        mvn test -Pdatabase,sqlserver,azuresql  -Ddatabase.host=... -Ddatabase.username=... -Ddatabase.password=...

      Declared after the profiles they refine, so that their database.url wins.
    -->
    <!--
      Aurora: the connection parameters are in settings/maven/pg_service.conf, which the environment
      variable PGSERVICEFILE has to point to - not in the URL, where an ampersand would need XML escaping.
    -->
    <profile>
      <!-- Amazon Aurora PostgreSQL 15 -->
      <id>aurora15</id>
      <properties>
        <database.url>jdbc:postgresql://${database.host}:${database.port}/${database.name}?service=aurora</database.url>
        <!-- not a Testcontainers URL: undo the Testcontainers driver of the postgresql profile -->
        <database.plugin.driver>${database.driver}</database.plugin.driver>
      </properties>
    </profile>

    <profile>
      <!-- Amazon Aurora PostgreSQL 16 -->
      <id>aurora16</id>
      <properties>
        <database.url>jdbc:postgresql://${database.host}:${database.port}/${database.name}?service=aurora</database.url>
        <!-- not a Testcontainers URL: undo the Testcontainers driver of the postgresql profile -->
        <database.plugin.driver>${database.driver}</database.plugin.driver>
      </properties>
    </profile>

    <profile>
      <!-- Amazon Aurora PostgreSQL 17 -->
      <id>aurora17</id>
      <properties>
        <database.url>jdbc:postgresql://${database.host}:${database.port}/${database.name}?service=aurora</database.url>
