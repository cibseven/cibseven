      </properties>
    </profile>

    <profile>
      <!-- Azure SQL Database -->
      <id>azuresql</id>
      <properties>
        <!-- the sqlserver profile names the database camengine, this one is called like the Aurora ones -->
        <database.name>process-engine</database.name>
        <!--
          loginTimeout is in seconds and covers the whole login including the TLS prelogin,
          so it is the only knob needed while the database resumes from auto-pause (default 30).
        -->
        <database.url>jdbc:sqlserver://${database.host}:${database.port};databaseName=${database.name};encrypt=true;trustServerCertificate=false;loginTimeout=90</database.url>
        <!-- not a Testcontainers URL: undo the Testcontainers driver of the sqlserver profile -->
        <database.plugin.driver>${database.driver}</database.plugin.driver>
      </properties>
    </profile>

    <!--
      One profile per tested database version, from Oleg's feat/tc-qa-tests. They only point the
      Testcontainers alias at another image tag; everything else comes from the database profile
      above. Only the versions of the support matrix are listed, of which the plain database
      profiles pin the oldest one each (see the supported environments of the documentation).
