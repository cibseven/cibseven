<?xml version="1.0" encoding="UTF-8"?>
<!-- Two completion rules at once. Must be refused at deployment: accepting it would mean silently
     ignoring one of them, and a latched condition would refuse the activation the property exists
     to keep possible. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             targetNamespace="http://cibseven.org/adhoc-parked">
  <process id="adHocParkedAndCondition" isExecutable="true">
    <startEvent id="start" />
    <sequenceFlow id="f1" sourceRef="start" targetRef="adHoc" />
    <adHocSubProcess id="adHoc">
      <extensionElements>
        <camunda:properties>
          <camunda:property name="explicitCompletionOnly" value="true" />
        </camunda:properties>
      </extensionElements>
      <userTask id="taskA" name="Task A" />
      <completionCondition xsi:type="tFormalExpression">${false}</completionCondition>
    </adHocSubProcess>
    <sequenceFlow id="f2" sourceRef="adHoc" targetRef="end" />
    <endEvent id="end" />
  </process>
</definitions>
