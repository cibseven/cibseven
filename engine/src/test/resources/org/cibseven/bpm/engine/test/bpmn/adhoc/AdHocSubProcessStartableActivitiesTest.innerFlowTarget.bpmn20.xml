<?xml version="1.0" encoding="UTF-8"?>
<!-- The second clause of the startable rule: 'second' is the target of a sequence flow inside the
     scope, so it is reached from 'first' rather than started directly. Cannot deploy while inner
     sequence flows are rejected, which is why the test using it is ignored against that decision. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             targetNamespace="http://cibseven.org/adhoc-scenarios">
  <process id="adHocInnerFlowTarget" isExecutable="true">
    <startEvent id="start" />
    <sequenceFlow id="f1" sourceRef="start" targetRef="adHoc" />
    <adHocSubProcess id="adHoc">
      <userTask id="first" />
      <sequenceFlow id="inner" sourceRef="first" targetRef="second" />
      <userTask id="second" />
    </adHocSubProcess>
    <sequenceFlow id="f2" sourceRef="adHoc" targetRef="end" />
    <endEvent id="end" />
  </process>
</definitions>
