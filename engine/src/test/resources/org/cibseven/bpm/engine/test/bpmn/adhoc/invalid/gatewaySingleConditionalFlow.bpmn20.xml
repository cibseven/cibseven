<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
             targetNamespace="http://cibseven.org/adhoc-invalid">
  <!-- A single outgoing flow that carries a condition: when it is false the token has nowhere to go. -->
  <process id="gatewayOneConditional" isExecutable="true">
    <startEvent id="start" />
    <sequenceFlow id="f1" sourceRef="start" targetRef="adHoc" />
    <adHocSubProcess id="adHoc">
      <userTask id="taskA" />
      <sequenceFlow id="toGw" sourceRef="taskA" targetRef="gw" />
      <exclusiveGateway id="gw" />
      <sequenceFlow id="onlyIfUrgent" sourceRef="gw" targetRef="taskB">
        <conditionExpression xsi:type="tFormalExpression">${urgent}</conditionExpression>
      </sequenceFlow>
      <userTask id="taskB" />
    </adHocSubProcess>
    <sequenceFlow id="f2" sourceRef="adHoc" targetRef="end" />
    <endEvent id="end" />
  </process>
</definitions>
