<?xml version="1.0" encoding="UTF-8"?>
<!-- Compensation reaching a completed child of an ad hoc scope. The throw names the scope, because
     compensating a sub process compensates the activities completed inside it, and the ad hoc scope
     is parsed as consuming compensation. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             targetNamespace="http://cibseven.org/adhoc-scenarios">
  <process id="adHocCompensation" isExecutable="true">
    <startEvent id="start" />
    <sequenceFlow id="f1" sourceRef="start" targetRef="adHoc" />
    <adHocSubProcess id="adHoc" name="Ad Hoc Scope">
      <userTask id="taskA" name="Task A" />
      <boundaryEvent id="compensateTaskA" attachedToRef="taskA">
        <compensateEventDefinition />
      </boundaryEvent>
      <serviceTask id="undoA" name="Undo A" isForCompensation="true"
                   camunda:expression="${execution.setVariable('compensated', true)}" />
      <association associationDirection="One" sourceRef="compensateTaskA" targetRef="undoA" />
    </adHocSubProcess>
    <sequenceFlow id="f2" sourceRef="adHoc" targetRef="wait" />
    <userTask id="wait" name="Wait" />
    <sequenceFlow id="f3" sourceRef="wait" targetRef="throwCompensation" />
    <endEvent id="throwCompensation">
      <compensateEventDefinition activityRef="adHoc" />
    </endEvent>
  </process>
</definitions>
