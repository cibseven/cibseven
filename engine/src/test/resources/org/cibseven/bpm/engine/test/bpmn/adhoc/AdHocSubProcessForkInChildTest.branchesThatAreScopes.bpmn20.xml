<?xml version="1.0" encoding="UTF-8"?>
<!-- CIB7-2264. A fork whose branches are scopes: left has an input mapping, right an
     interrupting boundary event that skips it. The label sits on the concurrent execution above each. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             targetNamespace="http://cibseven.org/adhoc-scenarios">
  <message id="skipMessage" name="skip" />
  <process id="branchesThatAreScopes" isExecutable="true">
    <startEvent id="start" />
    <sequenceFlow id="f1" sourceRef="start" targetRef="adHoc" />
    <adHocSubProcess id="adHoc">
      <serviceTask id="split" camunda:expression="${1}" />
      <sequenceFlow id="i1" sourceRef="split" targetRef="fork" />
      <parallelGateway id="fork" />
      <sequenceFlow id="i2" sourceRef="fork" targetRef="left" />
      <sequenceFlow id="i3" sourceRef="fork" targetRef="right" />
      <userTask id="left">
        <extensionElements>
          <camunda:inputOutput>
            <camunda:inputParameter name="side">left</camunda:inputParameter>
          </camunda:inputOutput>
        </extensionElements>
      </userTask>
      <userTask id="right" />
      <boundaryEvent id="skipped" attachedToRef="right">
        <messageEventDefinition messageRef="skipMessage" />
      </boundaryEvent>
      <sequenceFlow id="i4" sourceRef="left" targetRef="join" />
      <sequenceFlow id="i5" sourceRef="right" targetRef="join" />
      <sequenceFlow id="i6" sourceRef="skipped" targetRef="join" />
      <inclusiveGateway id="join" />
      <sequenceFlow id="i7" sourceRef="join" targetRef="after" />
      <userTask id="after" />
      <completionCondition xsi:type="tFormalExpression">${false}</completionCondition>
    </adHocSubProcess>
    <sequenceFlow id="f2" sourceRef="adHoc" targetRef="end" />
    <endEvent id="end" />
  </process>
</definitions>
