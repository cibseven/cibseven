<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             targetNamespace="http://cibseven.org/adhoc-scenarios">
  <!-- CIB7-1961. Same shape as adHocCancelFalse, except that every child carries an output
       mapping, which makes it a scope. That is the combination the attribute failed on. -->
  <process id="adHocCancelFalseScopeChildren" isExecutable="true">
    <startEvent id="start" />
    <sequenceFlow id="f1" sourceRef="start" targetRef="adHoc" />
    <adHocSubProcess id="adHoc" name="Ad Hoc Scope" cancelRemainingInstances="false">
      <userTask id="taskA" name="Task A">
        <extensionElements>
          <camunda:inputOutput>
            <camunda:outputParameter name="echoA">a</camunda:outputParameter>
          </camunda:inputOutput>
        </extensionElements>
      </userTask>
      <userTask id="taskB" name="Task B">
        <extensionElements>
          <camunda:inputOutput>
            <camunda:outputParameter name="echoB">b</camunda:outputParameter>
          </camunda:inputOutput>
        </extensionElements>
      </userTask>
      <userTask id="taskC" name="Task C">
        <extensionElements>
          <camunda:inputOutput>
            <camunda:outputParameter name="echoC">c</camunda:outputParameter>
          </camunda:inputOutput>
        </extensionElements>
      </userTask>
      <completionCondition xsi:type="tFormalExpression">${execution.hasVariable('done') and done}</completionCondition>
    </adHocSubProcess>
    <sequenceFlow id="f2" sourceRef="adHoc" targetRef="end" />
    <endEvent id="end" />
  </process>
</definitions>
