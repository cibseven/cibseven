<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             targetNamespace="http://cibseven.org/adhoc-scenarios">
  <!-- The condition is satisfied by 'taskA' while every instance of 'looped' is still waiting. -->
  <process id="adHocCancelMiChild" isExecutable="true">
    <startEvent id="start" />
    <sequenceFlow id="f1" sourceRef="start" targetRef="adHoc" />
    <adHocSubProcess id="adHoc" cancelRemainingInstances="true">
      <userTask id="looped">
        <multiInstanceLoopCharacteristics isSequential="false">
          <loopCardinality>3</loopCardinality>
        </multiInstanceLoopCharacteristics>
      </userTask>
      <userTask id="taskA" />
      <completionCondition xsi:type="tFormalExpression">${enough == true}</completionCondition>
    </adHocSubProcess>
    <sequenceFlow id="f2" sourceRef="adHoc" targetRef="end" />
    <endEvent id="end" />
  </process>
</definitions>
