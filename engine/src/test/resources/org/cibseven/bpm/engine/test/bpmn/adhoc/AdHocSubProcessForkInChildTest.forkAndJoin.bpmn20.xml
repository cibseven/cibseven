<?xml version="1.0" encoding="UTF-8"?>
<!-- CIB7-2264. A startable child whose flow forks into two branches and joins them again. The
     completion condition is false, so the scope stays open, and every path is gathered once, under
     the activity it ends in; a branch merged at the join is not. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             targetNamespace="http://cibseven.org/adhoc-scenarios">
  <process id="forkAndJoin" isExecutable="true">
    <startEvent id="start" />
    <sequenceFlow id="f1" sourceRef="start" targetRef="adHoc" />
    <adHocSubProcess id="adHoc">
      <extensionElements>
        <camunda:properties>
          <camunda:property name="outputCollection" value="results" />
          <camunda:property name="outputElement" value="${execution.currentActivityId}" />
        </camunda:properties>
      </extensionElements>
      <serviceTask id="split" camunda:expression="${1}" />
      <sequenceFlow id="i1" sourceRef="split" targetRef="fork" />
      <parallelGateway id="fork" />
      <sequenceFlow id="i2" sourceRef="fork" targetRef="left" />
      <sequenceFlow id="i3" sourceRef="fork" targetRef="right" />
      <userTask id="left" />
      <userTask id="right" />
      <sequenceFlow id="i4" sourceRef="left" targetRef="join" />
      <sequenceFlow id="i5" sourceRef="right" targetRef="join" />
      <parallelGateway id="join" />
      <sequenceFlow id="i6" sourceRef="join" targetRef="after" />
      <userTask id="after" />
      <userTask id="other" />
      <completionCondition xsi:type="tFormalExpression">${false}</completionCondition>
    </adHocSubProcess>
    <sequenceFlow id="f2" sourceRef="adHoc" targetRef="end" />
    <endEvent id="end" />
  </process>
</definitions>
