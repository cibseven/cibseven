<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
             targetNamespace="http://cibseven.org/adhoc-scenarios">
  <process id="adHocBaseline" isExecutable="true">
    <startEvent id="start" />
    <sequenceFlow id="f1" sourceRef="start" targetRef="adHoc" />
    <adHocSubProcess id="adHoc" name="Ad Hoc Scope">
      <userTask id="taskA" name="Task A" />
      <userTask id="taskB" name="Task B" />
      <userTask id="taskC" name="Task C" />
    </adHocSubProcess>
    <sequenceFlow id="f2" sourceRef="adHoc" targetRef="afterAdHoc" />
    <userTask id="afterAdHoc" name="After Ad Hoc" />
    <sequenceFlow id="f3" sourceRef="afterAdHoc" targetRef="end" />
    <endEvent id="end" />
  </process>
</definitions>
