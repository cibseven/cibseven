<?xml version="1.0" encoding="UTF-8"?>
<!-- CIB7-2264. Two children, each started on its own, that meet at one join: neither forks, so the
     join merges them as it always did. The completion condition is false, so the scope stays open. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             targetNamespace="http://cibseven.org/adhoc-scenarios">
  <process id="childrenJoinWithoutAFork" isExecutable="true">
    <startEvent id="start" />
    <sequenceFlow id="f1" sourceRef="start" targetRef="adHoc" />
    <adHocSubProcess id="adHoc">
      <userTask id="x" />
      <userTask id="y" />
      <sequenceFlow id="i1" sourceRef="x" targetRef="join" />
      <sequenceFlow id="i2" sourceRef="y" targetRef="join" />
      <parallelGateway id="join" />
      <sequenceFlow id="i3" sourceRef="join" targetRef="z" />
      <userTask id="z" />
      <completionCondition xsi:type="tFormalExpression">${false}</completionCondition>
    </adHocSubProcess>
    <sequenceFlow id="f2" sourceRef="adHoc" targetRef="end" />
    <endEvent id="end" />
  </process>
</definitions>
