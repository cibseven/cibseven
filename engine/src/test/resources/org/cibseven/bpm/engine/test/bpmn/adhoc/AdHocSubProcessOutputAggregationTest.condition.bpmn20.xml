<?xml version="1.0" encoding="UTF-8"?>
<!-- The completion condition reads what has been gathered so far. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             targetNamespace="http://cibseven.org/adhoc-scenarios">
  <process id="adHocGatherCondition" isExecutable="true">
    <startEvent id="start" />
    <sequenceFlow id="f1" sourceRef="start" targetRef="adHoc" />
    <adHocSubProcess id="adHoc">
      <extensionElements>
        <camunda:properties>
          <camunda:property name="outputCollection" value="results" />
          <camunda:property name="outputElement" value="${result}" />
        </camunda:properties>
      </extensionElements>
      <userTask id="tool">
        <extensionElements>
          <camunda:inputOutput>
            <camunda:outputParameter name="result">${in}</camunda:outputParameter>
          </camunda:inputOutput>
        </extensionElements>
      </userTask>
      <completionCondition xsi:type="tFormalExpression">${results != null and results.size() >= 2}</completionCondition>
    </adHocSubProcess>
    <sequenceFlow id="f2" sourceRef="adHoc" targetRef="end" />
    <endEvent id="end" />
  </process>
</definitions>
