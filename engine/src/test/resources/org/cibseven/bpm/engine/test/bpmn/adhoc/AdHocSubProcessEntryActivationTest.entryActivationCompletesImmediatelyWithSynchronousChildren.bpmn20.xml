<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
             targetNamespace="http://cibseven.org/adhoc">
  <process id="adHocEntrySync" isExecutable="true">
    <startEvent id="start" />
    <sequenceFlow id="toAdHoc" sourceRef="start" targetRef="adHoc" />
    <adHocSubProcess id="adHoc">
      <extensionElements>
        <camunda:properties>
          <camunda:property name="activeActivityIds" value="one,two" />
        </camunda:properties>
      </extensionElements>
      <serviceTask id="one" camunda:expression="${true}" />
      <serviceTask id="two" camunda:expression="${true}" />
    </adHocSubProcess>
    <sequenceFlow id="toEnd" sourceRef="adHoc" targetRef="afterAdHoc" />
    <userTask id="afterAdHoc" name="After" />
    <sequenceFlow id="toEnd2" sourceRef="afterAdHoc" targetRef="end" />
    <endEvent id="end" />
  </process>
</definitions>
