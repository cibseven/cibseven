<?xml version="1.0" encoding="UTF-8"?>
<!-- The same scope with the property explicitly false, which must behave exactly as an absent
     property: the scope ends once nothing is active and something was activated. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             targetNamespace="http://cibseven.org/adhoc-parked">
  <process id="adHocNotParked" isExecutable="true">
    <startEvent id="start" />
    <sequenceFlow id="f1" sourceRef="start" targetRef="adHoc" />
    <adHocSubProcess id="adHoc">
      <extensionElements>
        <camunda:properties>
          <camunda:property name="explicitCompletionOnly" value="false" />
        </camunda:properties>
      </extensionElements>
      <userTask id="taskA" name="Task A" />
      <userTask id="taskB" name="Task B" />
    </adHocSubProcess>
    <sequenceFlow id="f2" sourceRef="adHoc" targetRef="end" />
    <endEvent id="end" />
  </process>
</definitions>
