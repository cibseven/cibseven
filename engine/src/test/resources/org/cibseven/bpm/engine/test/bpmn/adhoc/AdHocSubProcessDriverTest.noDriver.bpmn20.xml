<?xml version="1.0" encoding="UTF-8"?>
<!-- Parked but without a driver: every model written before the property existed. Ending a child
     must re-activate nothing. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             targetNamespace="http://cibseven.org/adhoc-driver">
  <process id="adHocNoDriver" isExecutable="true">
    <startEvent id="start" />
    <sequenceFlow id="f1" sourceRef="start" targetRef="adHoc" />
    <adHocSubProcess id="adHoc">
      <extensionElements>
        <camunda:properties>
          <camunda:property name="explicitCompletionOnly" value="true" />
        </camunda:properties>
      </extensionElements>
      <userTask id="driver" name="Driver" />
      <userTask id="workerA" name="Worker A" />
    </adHocSubProcess>
    <sequenceFlow id="f2" sourceRef="adHoc" targetRef="end" />
    <endEvent id="end" />
  </process>
</definitions>
