<?xml version="1.0" encoding="UTF-8"?>
<!-- The completion condition is met on an inner flow: step writes the result the condition reads,
     and the flow out of it is where the scope finds out. cancelRemainingInstances is the default. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             targetNamespace="http://cibseven.org/adhoc-scenarios">
  <process id="adHocGatherInnerFlowCondition" isExecutable="true">
    <startEvent id="start" />
    <sequenceFlow id="f1" sourceRef="start" targetRef="adHoc" />
    <adHocSubProcess id="adHoc">
      <extensionElements>
        <camunda:properties>
          <camunda:property name="activeElementsCollection" value="other,step" />
          <camunda:property name="outputCollection" value="results" />
          <camunda:property name="outputElement" value="${execution.activityId == 'other' ? null : result}" />
        </camunda:properties>
      </extensionElements>
      <userTask id="other" />
      <serviceTask id="step" camunda:expression="${'A'}" camunda:resultVariable="result" />
      <sequenceFlow id="stepToNext" sourceRef="step" targetRef="next" />
      <userTask id="next" />
      <completionCondition xsi:type="tFormalExpression">${execution.getVariable('result') == 'A'}</completionCondition>
    </adHocSubProcess>
    <sequenceFlow id="f2" sourceRef="adHoc" targetRef="afterScope" />
    <userTask id="afterScope" />
    <sequenceFlow id="f3" sourceRef="afterScope" targetRef="end" />
    <endEvent id="end" />
  </process>
</definitions>
