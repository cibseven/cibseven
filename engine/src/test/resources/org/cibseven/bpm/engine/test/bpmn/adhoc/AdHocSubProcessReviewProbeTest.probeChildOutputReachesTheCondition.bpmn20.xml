<?xml version="1.0" encoding="UTF-8"?>
<!-- A child writes an output parameter and the completion condition reads it. This is the natural
     way to write a completion condition: BPMN 2.0.0 section 10.3.5 describes completion as a
     condition "that evaluates Process attributes that will have been updated by an Activity in the
     Process". -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             targetNamespace="http://cibseven.org/adhoc-probe">
  <process id="probeChildOutput" isExecutable="true">
    <startEvent id="start" /><sequenceFlow id="f1" sourceRef="start" targetRef="adHoc" />
    <adHocSubProcess id="adHoc">
      <userTask id="taskA">
        <extensionElements>
          <camunda:inputOutput>
            <camunda:outputParameter name="approved">${true}</camunda:outputParameter>
          </camunda:inputOutput>
        </extensionElements>
      </userTask>
      <userTask id="taskB" />
      <completionCondition xsi:type="tFormalExpression">${execution.hasVariable('approved') and approved}</completionCondition>
    </adHocSubProcess>
    <sequenceFlow id="f2" sourceRef="adHoc" targetRef="end" /><endEvent id="end" />
  </process>
</definitions>
