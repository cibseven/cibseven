<?xml version="1.0" encoding="UTF-8"?>
<!-- A scope with two waiting children, a synchronous one, and a non-startable catch event. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             targetNamespace="http://cibseven.org/adhoc-scenarios">
  <process id="adHocActivationApi" isExecutable="true">
    <startEvent id="start" />
    <sequenceFlow id="f1" sourceRef="start" targetRef="adHoc" />
    <adHocSubProcess id="adHoc">
      <userTask id="taskA" />
      <userTask id="taskB" />
      <serviceTask id="sync" camunda:expression="${execution.setVariable('ran', true)}" />
      <!-- An io mapping makes the activity a scope, so its instance is entered by a different
           execution than the one the command creates. -->
      <serviceTask id="syncWithIoMapping" camunda:expression="${true}">
        <extensionElements>
          <camunda:inputOutput>
            <camunda:outputParameter name="mapped">${true}</camunda:outputParameter>
          </camunda:inputOutput>
        </extensionElements>
      </serviceTask>
      <userTask id="multi">
        <multiInstanceLoopCharacteristics isSequential="false">
          <loopCardinality>2</loopCardinality>
        </multiInstanceLoopCharacteristics>
      </userTask>
      <intermediateCatchEvent id="waitForMsg">
        <messageEventDefinition messageRef="theMessage" />
      </intermediateCatchEvent>
    </adHocSubProcess>
    <sequenceFlow id="f2" sourceRef="adHoc" targetRef="end" />
    <endEvent id="end" />
  </process>
  <message id="theMessage" name="theMessage" />
</definitions>
