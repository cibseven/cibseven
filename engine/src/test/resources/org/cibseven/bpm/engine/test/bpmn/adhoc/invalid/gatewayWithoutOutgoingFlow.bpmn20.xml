<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
             targetNamespace="http://cibseven.org/adhoc-invalid">
  <!-- An exclusive gateway inside the scope with nowhere to go. Refused outside a scope, so refused here. -->
  <process id="gatewayDeadEnd" isExecutable="true">
    <startEvent id="start" />
    <sequenceFlow id="f1" sourceRef="start" targetRef="adHoc" />
    <adHocSubProcess id="adHoc">
      <userTask id="taskA" />
      <sequenceFlow id="toGw" sourceRef="taskA" targetRef="gw" />
      <exclusiveGateway id="gw" />
    </adHocSubProcess>
    <sequenceFlow id="f2" sourceRef="adHoc" targetRef="end" />
    <endEvent id="end" />
  </process>
</definitions>
