<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" targetNamespace="http://cibseven.org/edge">
  <message id="m" name="ping" />
  <process id="edgeBoundary" isExecutable="true" camunda:historyTimeToLive="P30D">
    <startEvent id="start" /><sequenceFlow id="f1" sourceRef="start" targetRef="scope" />
    <adHocSubProcess id="scope">
      <extensionElements><camunda:properties><camunda:property name="activeElementsCollection" value="work" /></camunda:properties></extensionElements>
      <userTask id="work" name="Work" />
