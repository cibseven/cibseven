<?xml version="1.0" encoding="UTF-8"?>
<!-- A gateway inside an ad hoc scope. BPMN 2.0.0 section 10.3.5 permits it; this engine does not,
     because a gateway needs the inner sequence flows we reject. The point of the fixture is the
     diagnostic: it must name the ad hoc constraint, not "gateway has no outgoing sequence flows". -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             targetNamespace="http://cibseven.org/adhoc-scenarios">
  <process id="adHocGateway" isExecutable="true">
    <startEvent id="start" />
    <sequenceFlow id="f1" sourceRef="start" targetRef="adHoc" />
    <adHocSubProcess id="adHoc">
      <userTask id="taskA" />
      <exclusiveGateway id="gw" />
    </adHocSubProcess>
    <sequenceFlow id="f2" sourceRef="adHoc" targetRef="end" />
    <endEvent id="end" />
  </process>
</definitions>
