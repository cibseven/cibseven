<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             targetNamespace="http://cibseven.org/adhoc-probe">
  <process id="probeIoCancel" isExecutable="true">
    <startEvent id="start" /><sequenceFlow id="f1" sourceRef="start" targetRef="adHoc" />
    <adHocSubProcess id="adHoc" cancelRemainingInstances="true">
      <userTask id="survivor" name="Survivor">
        <extensionElements>
          <camunda:inputOutput>
            <camunda:inputParameter name="inA">seed</camunda:inputParameter>
            <camunda:outputParameter name="outA">${'written'}</camunda:outputParameter>
          </camunda:inputOutput>
        </extensionElements>
      </userTask>
      <userTask id="trigger" name="Trigger">
        <extensionElements>
          <camunda:inputOutput>
            <camunda:inputParameter name="inB">seed</camunda:inputParameter>
            <camunda:outputParameter name="outB">${'written'}</camunda:outputParameter>
          </camunda:inputOutput>
        </extensionElements>
      </userTask>
      <completionCondition xsi:type="tFormalExpression">${execution.hasVariable('enough') and enough}</completionCondition>
    </adHocSubProcess>
    <sequenceFlow id="f2" sourceRef="adHoc" targetRef="end" /><endEvent id="end" />
  </process>
</definitions>
