<?xml version="1.0" encoding="UTF-8"?>

<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans   http://www.springframework.org/schema/beans/spring-beans.xsd">

  <bean id="processEngineConfiguration" class="org.cibseven.bpm.engine.impl.cfg.StandaloneInMemProcessEngineConfiguration">

    <property name="processEngineName" value="execution-allow-list-engine" />
    <property name="jdbcUrl" value="jdbc:h2:mem:execution-allow-list-engine" />

    <!-- CIB7-2653: both settings are plain String properties -->
    <property name="executionAllowList" value="External, groovy" />
    <property name="expressionHardeningMode" value="Report" />

  </bean>

</beans>
