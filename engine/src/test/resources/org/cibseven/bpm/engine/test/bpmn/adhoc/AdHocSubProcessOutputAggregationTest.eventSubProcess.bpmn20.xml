<?xml version="1.0" encoding="UTF-8"?>
<!-- A gathering scope with an interrupting event sub process: the handler is not a performance. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             targetNamespace="http://cibseven.org/adhoc-scenarios">
  <process id="adHocGatherEventSub" isExecutable="true">
    <startEvent id="start" />
    <sequenceFlow id="f1" sourceRef="start" targetRef="adHoc" />
    <adHocSubProcess id="adHoc">
      <extensionElements>
        <camunda:properties>
          <camunda:property name="outputCollection" value="results" />
          <camunda:property name="outputElement" value="${result}" />
        </camunda:properties>
      </extensionElements>
      <userTask id="tool">
        <extensionElements>
          <camunda:inputOutput>
            <camunda:outputParameter name="result">${in}</camunda:outputParameter>
          </camunda:inputOutput>
        </extensionElements>
      </userTask>
      <subProcess id="anEventSubProcess" triggeredByEvent="true">
        <startEvent id="eventStart" isInterrupting="true">
          <messageEventDefinition messageRef="theMessage" />
        </startEvent>
        <sequenceFlow id="ef1" sourceRef="eventStart" targetRef="handled" />
        <userTask id="handled" />
        <sequenceFlow id="ef2" sourceRef="handled" targetRef="eventEnd" />
        <endEvent id="eventEnd" />
      </subProcess>
      <completionCondition xsi:type="tFormalExpression">${false}</completionCondition>
    </adHocSubProcess>
    <sequenceFlow id="f2" sourceRef="adHoc" targetRef="end" />
    <endEvent id="end" />
  </process>
  <message id="theMessage" name="theMessage" />
</definitions>
