<?xml version="1.0" encoding="UTF-8"?>
<definitions id="definitions"
  xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
  targetNamespace="Examples">

  <process id="numberProcess" isExecutable="true">

    <startEvent id="start">
      <extensionElements>
        <camunda:executionListener event="end">
          <camunda:script scriptFormat="javascript">execution.setVariable('fromListener', java.lang.Long.valueOf(7));</camunda:script>
        </camunda:executionListener>
      </extensionElements>
    </startEvent>
    <sequenceFlow id="flow1" sourceRef="start" targetRef="scriptTask" />

    <scriptTask id="scriptTask" scriptFormat="javascript" camunda:resultVariable="fromResult">
      <extensionElements>
        <camunda:inputOutput>
          <camunda:outputParameter name="fromOutputMapping">
            <camunda:script scriptFormat="javascript">execution.getVariable('lng')</camunda:script>
          </camunda:outputParameter>
        </camunda:inputOutput>
      </extensionElements>
      <script>execution.getVariable('lng')</script>
    </scriptTask>
    <sequenceFlow id="flow2" sourceRef="scriptTask" targetRef="userTask" />

    <userTask id="userTask" />
    <sequenceFlow id="flow3" sourceRef="userTask" targetRef="end" />

    <endEvent id="end" />

  </process>

</definitions>
