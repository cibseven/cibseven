<?xml version="1.0" encoding="UTF-8"?>
<!-- CIB7-2269. A non-interrupting boundary event without an outgoing flow, which only records that
     its event happened, on an activity of a scope that gathers the variable `result`. The
     completion condition is false, so the scope stays open. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             targetNamespace="http://cibseven.org/adhoc-scenarios">
  <message id="pingMessage" name="ping" />
  <process id="flowlessBoundary" isExecutable="true">
    <startEvent id="start" />
    <sequenceFlow id="f1" sourceRef="start" targetRef="adHoc" />
    <adHocSubProcess id="adHoc">
      <extensionElements>
        <camunda:properties>
          <camunda:property name="outputCollection" value="results" />
          <camunda:property name="outputElement" value="${result}" />
        </camunda:properties>
      </extensionElements>
      <userTask id="work" />
      <boundaryEvent id="pinged" attachedToRef="work" cancelActivity="false">
        <messageEventDefinition messageRef="pingMessage" />
      </boundaryEvent>
      <completionCondition xsi:type="tFormalExpression">${false}</completionCondition>
    </adHocSubProcess>
    <sequenceFlow id="f2" sourceRef="adHoc" targetRef="end" />
    <endEvent id="end" />
  </process>
</definitions>
