<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
             targetNamespace="http://cibseven.org/adhoc-scenarios">
  <!-- No completion condition. 'looped' is wrapped in a multi-instance body, which is the scope's
       direct child; its instances run one level below. Neither the sibling ending nor one instance
       ending may be read as "nothing is active". -->
  <process id="adHocParallelMiChild" isExecutable="true">
    <startEvent id="start" />
    <sequenceFlow id="f1" sourceRef="start" targetRef="adHoc" />
    <adHocSubProcess id="adHoc">
      <userTask id="looped">
        <multiInstanceLoopCharacteristics isSequential="false">
          <loopCardinality>2</loopCardinality>
        </multiInstanceLoopCharacteristics>
      </userTask>
      <userTask id="quick" />
    </adHocSubProcess>
    <sequenceFlow id="f2" sourceRef="adHoc" targetRef="after" />
    <userTask id="after" />
    <sequenceFlow id="f3" sourceRef="after" targetRef="end" />
    <endEvent id="end" />
  </process>
</definitions>
