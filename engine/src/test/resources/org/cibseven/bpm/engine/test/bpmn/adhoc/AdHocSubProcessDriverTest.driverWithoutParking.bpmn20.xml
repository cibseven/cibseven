<?xml version="1.0" encoding="UTF-8"?>
<!-- A driver without parking. Refused at deployment: the scope would end as soon as the driver's
     first turn did, because nothing is active afterwards, so there would never be a second turn. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             targetNamespace="http://cibseven.org/adhoc-driver">
  <process id="adHocDriverNoParking" isExecutable="true">
    <startEvent id="start" />
    <sequenceFlow id="f1" sourceRef="start" targetRef="adHoc" />
    <adHocSubProcess id="adHoc">
      <extensionElements>
        <camunda:properties>
          <camunda:property name="adHocDriverActivity" value="driver" />
        </camunda:properties>
      </extensionElements>
      <userTask id="driver" name="Driver" />
    </adHocSubProcess>
    <sequenceFlow id="f2" sourceRef="adHoc" targetRef="end" />
    <endEvent id="end" />
  </process>
</definitions>
