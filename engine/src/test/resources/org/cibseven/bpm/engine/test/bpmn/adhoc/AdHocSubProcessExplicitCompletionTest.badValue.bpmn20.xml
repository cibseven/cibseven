<?xml version="1.0" encoding="UTF-8"?>
<!-- A misspelt value. Refused rather than read as false: reading it as false would deploy a scope
     that ends the moment its last child does, which is the failure the property prevents, and it
     would only surface in production. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             targetNamespace="http://cibseven.org/adhoc-parked">
  <process id="adHocBadValue" isExecutable="true">
    <startEvent id="start" />
    <sequenceFlow id="f1" sourceRef="start" targetRef="adHoc" />
    <adHocSubProcess id="adHoc">
      <extensionElements>
        <camunda:properties>
          <camunda:property name="explicitCompletionOnly" value="ture" />
        </camunda:properties>
      </extensionElements>
      <userTask id="taskA" name="Task A" />
    </adHocSubProcess>
    <sequenceFlow id="f2" sourceRef="adHoc" targetRef="end" />
    <endEvent id="end" />
  </process>
</definitions>
