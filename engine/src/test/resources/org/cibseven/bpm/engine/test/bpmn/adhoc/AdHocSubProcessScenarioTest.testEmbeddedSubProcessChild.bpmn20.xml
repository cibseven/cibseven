<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
             targetNamespace="http://cibseven.org/adhoc-scenarios">
  <process id="adHocNested" isExecutable="true">
    <startEvent id="start" />
    <sequenceFlow id="f1" sourceRef="start" targetRef="adHoc" />
    <adHocSubProcess id="adHoc" name="Ad Hoc Scope">
      <subProcess id="inner" name="Inner">
        <startEvent id="innerStart" />
        <sequenceFlow id="if1" sourceRef="innerStart" targetRef="innerTask" />
        <userTask id="innerTask" name="Inner Task" />
        <sequenceFlow id="if2" sourceRef="innerTask" targetRef="innerEnd" />
        <endEvent id="innerEnd" />
      </subProcess>
      <userTask id="taskA" name="Task A" />
    </adHocSubProcess>
    <sequenceFlow id="f2" sourceRef="adHoc" targetRef="end" />
    <endEvent id="end" />
  </process>
</definitions>
