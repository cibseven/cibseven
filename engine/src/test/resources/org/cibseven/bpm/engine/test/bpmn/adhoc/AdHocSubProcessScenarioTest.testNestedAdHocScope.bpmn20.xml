<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             targetNamespace="http://cibseven.org/adhoc-scenarios">
  <process id="adHocNestedAdHoc" isExecutable="true">
    <startEvent id="start" />
    <sequenceFlow id="f1" sourceRef="start" targetRef="outer" />
    <adHocSubProcess id="outer">
      <adHocSubProcess id="inner">
        <userTask id="innerTask" name="Inner Task" />
      </adHocSubProcess>
      <userTask id="outerTask" name="Outer Task" />
    </adHocSubProcess>
    <sequenceFlow id="f2" sourceRef="outer" targetRef="end" />
    <endEvent id="end" />
  </process>
</definitions>
