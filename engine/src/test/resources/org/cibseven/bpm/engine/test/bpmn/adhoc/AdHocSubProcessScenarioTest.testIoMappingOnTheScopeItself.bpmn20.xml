<?xml version="1.0" encoding="UTF-8"?>
<!-- camunda:inputOutput on the ad hoc sub process itself. tAdHocSubProcess extends tSubProcess, so
     it supports io mappings for the same reason subProcess does. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             targetNamespace="http://cibseven.org/adhoc-scenarios">
  <process id="adHocScopeIoMapping" isExecutable="true">
    <startEvent id="start" />
    <sequenceFlow id="f1" sourceRef="start" targetRef="adHoc" />
    <adHocSubProcess id="adHoc">
      <extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="budget">${100}</camunda:inputParameter>
          <camunda:outputParameter name="spent">${budget}</camunda:outputParameter>
        </camunda:inputOutput>
      </extensionElements>
      <userTask id="taskA" />
    </adHocSubProcess>
    <sequenceFlow id="f2" sourceRef="adHoc" targetRef="end" />
    <endEvent id="end" />
  </process>
</definitions>
