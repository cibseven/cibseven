<?xml version="1.0" encoding="UTF-8"?>
<!-- The driver names an element that is not directly startable. A driver is always one fixed id, so
     unlike activeActivityIds this can be caught before anything runs. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             targetNamespace="http://cibseven.org/adhoc-driver">
  <process id="adHocDriverUnstartable" isExecutable="true">
    <startEvent id="start" />
    <sequenceFlow id="f1" sourceRef="start" targetRef="adHoc" />
    <adHocSubProcess id="adHoc">
      <extensionElements>
        <camunda:properties>
          <camunda:property name="explicitCompletionOnly" value="true" />
          <camunda:property name="adHocDriverActivity" value="nosuch" />
        </camunda:properties>
      </extensionElements>
      <userTask id="driver" name="Driver" />
    </adHocSubProcess>
    <sequenceFlow id="f2" sourceRef="adHoc" targetRef="end" />
    <endEvent id="end" />
  </process>
</definitions>
