<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
             targetNamespace="http://cibseven.org/adhoc">
  <process id="adHocEntryBad" isExecutable="true">
    <startEvent id="start" />
    <sequenceFlow id="toAdHoc" sourceRef="start" targetRef="adHoc" />
    <adHocSubProcess id="adHoc">
      <extensionElements>
        <camunda:properties>
          <camunda:property name="activeActivityIds" value="taskA,nosuch" />
        </camunda:properties>
      </extensionElements>
      <userTask id="taskA" name="Task A" />
    </adHocSubProcess>
    <sequenceFlow id="toEnd" sourceRef="adHoc" targetRef="end" />
    <endEvent id="end" />
  </process>
</definitions>
