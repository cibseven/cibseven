<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>
  <name>CIB seven - Java External Task Client - CLIENT - Jackson 2 (deprecated)</name>

  <!--
    DEPRECATED, removed in CIB seven 3.1.0.

    The external task client on Jackson 2, for applications that cannot move to Jackson 3 yet. Same packages and
    classes as cibseven-external-task-client (Jackson 3): never put both on one class path (the client refuses to
    start, see JacksonVariantCheck).

    Only the classes that use Jackson live in this module (src/main/java, the Jackson 2 code of CIB seven 2.x).
    All other classes and the resources are taken from ../client at build time; the shared unit tests
    (../client/src/test, without *Jackson3Test) run against this variant, too.
  -->
  <artifactId>cibseven-external-task-client-jackson2</artifactId>

  <packaging>jar</packaging>

  <parent>
    <groupId>org.cibseven.bpm</groupId>
    <artifactId>cibseven-external-task-client-root</artifactId>
    <version>3.0.0-SNAPSHOT</version>
  </parent>

  <properties>
    <client.dir>${project.basedir}/../client</client.dir>
    <client.shared.sources>${project.build.directory}/generated-sources/client-shared</client.shared.sources>
    <client.shared.test-sources>${project.build.directory}/generated-test-sources/client-shared</client.shared.test-sources>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.cibseven.bpm</groupId>
        <artifactId>cibseven-core-internal-dependencies</artifactId>
        <version>${project.version}</version>
        <scope>import</scope>
        <type>pom</type>
      </dependency>
      <dependency>
        <groupId>com.fasterxml.jackson</groupId>
        <artifactId>jackson-bom</artifactId>
        <version>${version.jackson}</version>
        <scope>import</scope>
        <type>pom</type>
      </dependency>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${version.junit5}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>

    <!-- same as cibseven-external-task-client, but Jackson 2 -->
    <dependency>
      <groupId>org.cibseven.commons</groupId>
      <artifactId>cibseven-commons-logging</artifactId>
      <exclusions>
        <exclusion>
          <groupId>org.junit.jupiter</groupId>
          <artifactId>junit-jupiter-api</artifactId>
        </exclusion>
        <exclusion>
          <groupId>org.junit.jupiter</groupId>
          <artifactId>junit-jupiter-params</artifactId>
        </exclusion>
        <exclusion>
          <groupId>org.junit.jupiter</groupId>
          <artifactId>junit-jupiter-engine</artifactId>
        </exclusion>
      </exclusions>
    </dependency>

    <dependency>
      <groupId>org.cibseven.commons</groupId>
      <artifactId>cibseven-commons-typed-values</artifactId>
      <exclusions>
        <exclusion>
          <groupId>org.junit.jupiter</groupId>
          <artifactId>junit-jupiter-api</artifactId>
        </exclusion>
        <exclusion>
          <groupId>org.junit.jupiter</groupId>
          <artifactId>junit-jupiter-params</artifactId>
        </exclusion>
        <exclusion>
          <groupId>org.junit.jupiter</groupId>
          <artifactId>junit-jupiter-engine</artifactId>
        </exclusion>
      </exclusions>
    </dependency>

    <dependency>
      <groupId>org.apache.httpcomponents.client5</groupId>
      <artifactId>httpclient5</artifactId>
      <version>${version.httpclient5}</version>
    </dependency>

    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>

    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-api</artifactId>
      <version>${version.jjwt}</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-impl</artifactId>
      <version>${version.jjwt}</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-jackson</artifactId> <!-- or jjwt-gson if Gson is preferred -->
      <version>${version.jjwt}</version>
      <optional>true</optional>
    </dependency>

    <dependency>
      <groupId>jakarta.xml.bind</groupId>
      <artifactId>jakarta.xml.bind-api</artifactId>
      <version>${version.jakarta.xml.bind-api}</version>
    </dependency>

    <!-- test dependencies of the shared unit tests -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-params</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-engine</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-launcher</artifactId>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>jcl-over-slf4j</artifactId>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>${version.assertj}</version>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-core</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- ReflectUtil in ExternalTaskClientBuilderImplTest -->
    <dependency>
      <groupId>org.cibseven.bpm</groupId>
      <artifactId>cibseven-engine</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>

  </dependencies>

  <build>

    <resources>
      <resource>
        <directory>${client.dir}/src/main/resources</directory>
        <excludes>
          <exclude>META-INF/cibseven/external-task-client-jackson3.properties</exclude>
        </excludes>
      </resource>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
    </resources>

    <testResources>
      <testResource>
        <directory>${client.dir}/src/test/resources</directory>
      </testResource>
    </testResources>

    <plugins>

      <!-- copy the shared sources of ../client, without the classes that use Jackson 3 -->
      <plugin>
        <artifactId>maven-resources-plugin</artifactId>
        <executions>
          <execution>
            <id>copy-shared-client-sources</id>
            <phase>initialize</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>${client.shared.sources}</outputDirectory>
              <overwrite>true</overwrite>
              <resources>
                <resource>
                  <directory>${client.dir}/src/main/java</directory>
                  <excludes>
                    <!-- keep in sync with src/main/java of this module -->
                    <exclude>org/cibseven/bpm/client/impl/ExternalTaskClientBuilderImpl.java</exclude>
                    <exclude>org/cibseven/bpm/client/impl/RequestExecutor.java</exclude>
                    <exclude>org/cibseven/bpm/client/interceptor/auth/OAuth2ClientCredentialsProvider.java</exclude>
                    <exclude>org/cibseven/bpm/client/variable/impl/format/json/DefaultJsonJacksonTypeDetector.java</exclude>
                    <exclude>org/cibseven/bpm/client/variable/impl/format/json/JacksonJsonDataFormat.java</exclude>
                    <exclude>org/cibseven/bpm/client/variable/impl/format/json/ListJacksonJsonTypeDetector.java</exclude>
                  </excludes>
                </resource>
              </resources>
            </configuration>
          </execution>
          <execution>
            <id>copy-shared-client-test-sources</id>
            <phase>initialize</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>${client.shared.test-sources}</outputDirectory>
              <overwrite>true</overwrite>
              <resources>
                <resource>
                  <directory>${client.dir}/src/test/java</directory>
                  <excludes>
                    <exclude>**/*Jackson3Test.java</exclude>
                  </excludes>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>add-shared-client-sources</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>add-source</goal>
            </goals>
            <configuration>
              <sources>
                <source>${client.shared.sources}</source>
              </sources>
            </configuration>
          </execution>
          <execution>
            <id>add-shared-client-test-sources</id>
            <phase>generate-test-sources</phase>
            <goals>
              <goal>add-test-source</goal>
            </goals>
            <configuration>
              <sources>
                <source>${client.shared.test-sources}</source>
              </sources>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <trimStackTrace>false</trimStackTrace>
        </configuration>
      </plugin>

    </plugins>
  </build>

  <description>
    DEPRECATED (removed in CIB seven 3.1.0): the CIB seven Java External Task Client on Jackson 2. Use
    cibseven-external-task-client (Jackson 3) instead. Never put both on one class path.
  </description>

  <licenses>
    <license>
      <name>The Apache Software License, Version 2.0</name>
      <url>http://www.apache.org/licenses/LICENSE-2.0.txt</url>
    </license>
  </licenses>

  <organization>
    <name>CIB seven</name>
    <url>https://cibseven.org</url>
  </organization>

  <url>https://cibseven.org</url>

  <developers>
    <developer>
      <id>CIB seven</id>
      <name>CIB seven Community</name>
      <organization>CIB seven</organization>
      <organizationUrl>https://cibseven.org</organizationUrl>
    </developer>
  </developers>

  <scm>
    <url>https://github.com/cibseven/cibseven</url>
    <connection>scm:git:git@github.com:cibseven/cibseven.git</connection>
    <developerConnection>scm:git:git@github.com:cibseven/cibseven.git</developerConnection>
    <tag>HEAD</tag>
  </scm>

  <issueManagement>
    <system>GitHub Issues</system>
    <url>https://github.com/cibseven/cibseven/issues</url>
  </issueManagement>

</project>
